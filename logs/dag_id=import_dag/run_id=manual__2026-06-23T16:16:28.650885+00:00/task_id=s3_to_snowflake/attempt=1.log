{"timestamp":"2026-06-23T16:16:51.233095Z","level":"info","event":"Executing: USE DATABASE GRAMMY_ANALYSIS;\nUSE SCHEMA RAW;\n\n\nCREATE STORAGE INTEGRATION IF NOT EXISTS s3_data_integration\n    TYPE = EXTERNAL_STAGE\n    STORAGE_PROVIDER = 'S3'\n    STORAGE_AWS_ROLE_ARN = 'arn:aws:iam::552153077634:role/snowflake_access'\n    ENABLED = TRUE\n    STORAGE_ALLOWED_LOCATIONS = ('*');\n\n--uncomment and run the below to find the external id and user arn for configuring aws role\n-- DESC INTEGRATION s3_data_integration;\n\n\nCREATE OR REPLACE STAGE s3data_stage\n    STORAGE_INTEGRATION = s3_data_integration\n    URL = 's3://grammy-analysis-552153077634-us-east-1-an/'\n    FILE_FORMAT = (TYPE = CSV,\n                    SKIP_HEADER = 1,\n                    FIELD_OPTIONALLY_ENCLOSED_BY='\"');\n\nCREATE OR REPLACE TABLE GRAMMY_WINNER_DATA (\n    YEAR INT,\n    CEREMONY_NUMBER INT,\n    DECADE INT,\n    ERA VARCHAR(50),\n    CATEGORY VARCHAR(50),\n    AWARD_GROUP VARCHAR(10),\n    WINNER VARCHAR(255),\n    ARTIST VARCHAR(400),\n    STATUS VARCHAR(10),\n    TOTAL_WINS INT,\n    CATEGORY_TOTAL_WINNERS INT,\n    DATA_SOURCE VARCHAR(20),\n    COLLECTION_DATE DATE\n);\n\n\nCOPY INTO GRAMMY_WINNER_DATA\n    FROM @s3data_stage\n        FILES = ('Grammy_Awards_Winners_20260208_055452.csv');\n        -- VALIDATION_MODE = RETURN_ALL_ERRORS;\n","dag_id":"import_dag","try_number":1,"map_index":-1,"ti_id":"019ef544-d29e-7754-b6aa-33f20b84a040","run_id":"manual__2026-06-23T16:16:28.650885+00:00","task_id":"s3_to_snowflake","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
